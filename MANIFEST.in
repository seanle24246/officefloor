include README.md
include PYPI_README.md
include LICENSE
include CREDITS.md
include AGENT-PROTOCOL.md
include office_cli.py
include serve.py
include qa/tools/wheel_meta_scan.py
include mvp_manifest.json
recursive-include server *.py
