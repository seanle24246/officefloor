{
  "schema": 1,
  "product": "the-office",
  "version_file": "VERSION",
  "compiler": {
    "package": "Nuitka",
    "version": "4.1.3",
    "requirement": "Nuitka[onefile]==4.1.3",
    "source_sha256": "838ff8899dc2f0b652d4fcf6c5d7466cb7ad5abcb005668ac622d1e40f4d8a8d",
    "onefile_compressor": {
      "package": "zstandard",
      "version": "0.25.0"
    },
    "mode": "onefile",
    "entrypoint": "serve.py",
    "output_filename": "office-server",
    "flags": [
      "--mode=onefile",
      "--include-package=server",
      "--include-data-dir={source}/static=static",
      "--include-data-dir={source}/data=data",
      "--include-data-files={source}/VERSION=VERSION",
      "--output-dir={build}",
      "--output-filename=office-server",
      "--company-name=The Office",
      "--product-name=The Office Server",
      "--file-description=The Office loopback server",
      "--file-version={version}",
      "--product-version={version}",
      "--static-libpython=no"
    ]
  },
  "application": {
    "name": "The Office",
    "bundle_identifier": "com.theoffice.server",
    "minimum_macos": "11.0",
    "server_mode": "demo",
    "host": "127.0.0.1",
    "port": 8787,
    "launcher_source": "packaging/nuitka/app_launcher.c"
  },
  "release": {
    "requires_developer_id": true,
    "requires_hardened_runtime": true,
    "requires_secure_timestamp": true,
    "requires_notarization": true,
    "dmg_volume_name": "The Office"
  }
}
